# syntax=docker/dockerfile:1

FROM golang:1.27.1-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -o /out/worker ./cmd/worker

FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir torch==2.11.0 --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir numpy==2.3.5 demucs==4.1.0

RUN mkdir -p /data/media/incoming /data/media/songs /data/media/work /data/media/cache \
    && chown -R 65532:65532 /data/media
COPY --from=build /out/worker /usr/local/bin/worker

ENV MEDIA_ROOT=/data/media \
    XDG_CACHE_HOME=/data/media/cache \
    PYTHONDONTWRITEBYTECODE=1
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/worker"]
